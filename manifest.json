{
  "manifest_version": 3,
  "name": "OLD-VK",
  "version": "1.0",
  "description": "Расширение для возвращения старого стиля вк",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Включить / выключить скин 2015",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://vk.ru/*", "*://*.vk.ru/*", "*://vk.com/*", "*://*.vk.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
